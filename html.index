<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Pro Pack Scanner</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #0f1117;
    color: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── TOP BAR ── */
  .topbar {
    background: #1a1d27;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #2a2d3a;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .topbar h1 { font-size: 18px; font-weight: 700; letter-spacing: 0.5px; }
  .topbar h1 span { color: #3b82f6; }
  .status-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: #ef4444; transition: background 0.3s;
  }
  .status-dot.connected { background: #22c55e; }

  /* ── MODE TABS ── */
  .mode-tabs {
    display: flex;
    background: #1a1d27;
    border-bottom: 1px solid #2a2d3a;
  }
  .mode-tab {
    flex: 1; padding: 14px 8px; text-align: center;
    font-size: 13px; font-weight: 600; cursor: pointer;
    border-bottom: 3px solid transparent;
    color: #6b7280; transition: all 0.2s;
  }
  .mode-tab.active { color: #3b82f6; border-bottom-color: #3b82f6; }

  /* ── MAIN CONTENT ── */
  .content { flex: 1; padding: 16px; max-width: 480px; margin: 0 auto; width: 100%; }

  /* ── CAMERA ── */
  .camera-wrap {
    position: relative; width: 100%; padding-top: 75%;
    background: #000; border-radius: 12px; overflow: hidden;
    margin-bottom: 16px; border: 2px solid #2a2d3a;
  }
  .camera-wrap video, .camera-wrap canvas {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  .scan-line {
    position: absolute; top: 50%; left: 10%; width: 80%; height: 2px;
    background: linear-gradient(90deg, transparent, #3b82f6, transparent);
    animation: scanAnim 2s ease-in-out infinite;
    z-index: 10;
  }
  @keyframes scanAnim {
    0%, 100% { top: 30%; opacity: 0.3; }
    50% { top: 70%; opacity: 1; }
  }
  .scan-corner {
    position: absolute; width: 20px; height: 20px;
    border-color: #3b82f6; border-style: solid; z-index: 10;
  }
  .scan-corner.tl { top: 12%; left: 10%; border-width: 3px 0 0 3px; }
  .scan-corner.tr { top: 12%; right: 10%; border-width: 3px 3px 0 0; }
  .scan-corner.bl { bottom: 12%; left: 10%; border-width: 0 0 3px 3px; }
  .scan-corner.br { bottom: 12%; right: 10%; border-width: 0 3px 3px 0; }

  .camera-placeholder {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: #6b7280; gap: 12px; font-size: 14px; text-align: center; padding: 16px;
  }
  .camera-placeholder .icon { font-size: 48px; }

  /* ── BUTTONS ── */
  .btn {
    width: 100%; padding: 14px; border: none; border-radius: 10px;
    font-size: 16px; font-weight: 600; cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn:active { opacity: 0.8; transform: scale(0.98); }
  .btn-blue { background: #3b82f6; color: #fff; }
  .btn-green { background: #22c55e; color: #fff; }
  .btn-red { background: #ef4444; color: #fff; }
  .btn-gray { background: #2a2d3a; color: #9ca3af; }
  .btn-orange { background: #f59e0b; color: #fff; }

  /* ── RESULT CARD ── */
  .result-card {
    background: #1a1d27; border-radius: 12px;
    padding: 16px; margin-bottom: 16px;
    border: 1px solid #2a2d3a;
    display: none;
  }
  .result-card.show { display: block; }
  .result-card.success { border-color: #22c55e; }
  .result-card.error { border-color: #ef4444; }
  .result-card.warning { border-color: #f59e0b; }

  .result-title { font-size: 13px; color: #6b7280; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
  .result-value { font-size: 20px; font-weight: 700; word-break: break-all; }
  .result-meta { font-size: 13px; color: #9ca3af; margin-top: 6px; }

  /* ── FORM ── */
  .form-group { margin-bottom: 12px; }
  .form-label { font-size: 12px; color: #9ca3af; margin-bottom: 6px; display: block; text-transform: uppercase; letter-spacing: 0.5px; }
  .form-input {
    width: 100%; padding: 12px 14px; background: #1a1d27;
    border: 1px solid #2a2d3a; border-radius: 8px;
    color: #fff; font-size: 16px;
  }
  .form-input:focus { outline: none; border-color: #3b82f6; }

  /* ── LOG ── */
  .log-wrap {
    background: #1a1d27; border-radius: 12px;
    border: 1px solid #2a2d3a; margin-top: 16px;
    max-height: 220px; overflow-y: auto;
  }
  .log-title {
    padding: 10px 14px; font-size: 12px; font-weight: 600;
    color: #6b7280; border-bottom: 1px solid #2a2d3a;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .log-item {
    padding: 8px 14px; font-size: 13px; border-bottom: 1px solid #1f2230;
    display: flex; gap: 8px; align-items: flex-start;
  }
  .log-item:last-child { border-bottom: none; }
  .log-time { color: #4b5563; white-space: nowrap; font-size: 11px; padding-top: 2px; }
  .log-msg { flex: 1; }
  .log-msg.success { color: #22c55e; }
  .log-msg.error { color: #ef4444; }
  .log-msg.warning { color: #f59e0b; }
  .log-msg.info { color: #9ca3af; }

  /* ── SETUP SCREEN ── */
  .setup-screen {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: #0f1117; z-index: 999;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 24px;
  }
  .setup-screen h2 { font-size: 22px; margin-bottom: 8px; }
  .setup-screen p { color: #6b7280; font-size: 14px; margin-bottom: 24px; text-align: center; }
  .setup-logo { font-size: 48px; margin-bottom: 16px; }

  /* ── TOAST ── */
  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: #1a1d27; color: #fff; padding: 12px 20px;
    border-radius: 10px; font-size: 14px; font-weight: 600;
    border: 1px solid #2a2d3a; z-index: 9999;
    transition: opacity 0.3s; white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }

  .section-title {
    font-size: 13px; color: #6b7280; margin-bottom: 12px;
    text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;
  }

  .stock-badge {
    display: inline-block; padding: 3px 10px; border-radius: 20px;
    font-size: 13px; font-weight: 700;
  }
  .stock-badge.ok { background: #14532d; color: #22c55e; }
  .stock-badge.low { background: #451a03; color: #f59e0b; }
  .stock-badge.empty { background: #450a0a; color: #ef4444; }

  .divider { height: 1px; background: #2a2d3a; margin: 16px 0; }
</style>
</head>
<body>

<!-- ── SETUP SCREEN ── -->
<div class="setup-screen" id="setupScreen">
  <div class="setup-logo">📦</div>
  <h2>Pro Pack Scanner</h2>
  <p>Supabase bağlantı bilgilerinizi girin</p>
  <div style="width:100%;max-width:400px;">
    <div class="form-group">
      <label class="form-label">Supabase URL</label>
      <input class="form-input" id="setupUrl" placeholder="https://xxxx.supabase.co" type="url" autocomplete="off">
    </div>
    <div class="form-group">
      <label class="form-label">Anon Key</label>
      <input class="form-input" id="setupKey" placeholder="eyJ..." type="password" autocomplete="off">
    </div>
    <button class="btn btn-blue" onclick="saveSetup()" style="margin-top:8px;">
      Bağlan →
    </button>
    <p style="text-align:center;margin-top:12px;font-size:12px;color:#4b5563;">
      Bilgiler cihazda saklanır, paylaşılmaz.
    </p>
  </div>
</div>

<!-- ── TOP BAR ── -->
<div class="topbar">
  <h1>Pro<span>Pack</span> 📱</h1>
  <div style="display:flex;align-items:center;gap:10px;">
    <span style="font-size:12px;color:#4b5563;" id="connLabel">Bağlanıyor...</span>
    <div class="status-dot" id="statusDot"></div>
  </div>
</div>

<!-- ── MODE TABS ── -->
<div class="mode-tabs">
  <div class="mode-tab active" id="tab-stock-in" onclick="switchMode('stock-in')">📥 Stok Giriş</div>
  <div class="mode-tab" id="tab-package-out" onclick="switchMode('package-out')">📤 Paket Çıkış</div>
  <div class="mode-tab" id="tab-manual" onclick="switchMode('manual')">✏️ Manuel</div>
</div>

<!-- ── CONTENT ── -->
<div class="content">

  <!-- RESULT CARD -->
  <div class="result-card" id="resultCard">
    <div class="result-title" id="resultTitle">Son Tarama</div>
    <div class="result-value" id="resultValue">—</div>
    <div class="result-meta" id="resultMeta"></div>
  </div>

  <!-- ── STOCK IN MODE ── -->
  <div id="mode-stock-in">
    <p class="section-title">Stok Ekle / Güncelle</p>

    <div class="camera-wrap" id="cameraWrap-stock-in">
      <div class="camera-placeholder" id="placeholder-stock-in">
        <div class="icon">📷</div>
        <div>Kamera başlatmak için aşağıdaki butona basın</div>
      </div>
      <video id="video-stock-in" autoplay playsinline style="display:none;"></video>
      <div class="scan-line" id="scanLine-stock-in" style="display:none;"></div>
      <div class="scan-corner tl" id="sc-tl-si" style="display:none;"></div>
      <div class="scan-corner tr" id="sc-tr-si" style="display:none;"></div>
      <div class="scan-corner bl" id="sc-bl-si" style="display:none;"></div>
      <div class="scan-corner br" id="sc-br-si" style="display:none;"></div>
    </div>

    <div class="form-group">
      <label class="form-label">Miktar</label>
      <input class="form-input" id="stockInQty" type="number" value="1" min="1">
    </div>

    <button class="btn btn-green" id="startBtn-stock-in" onclick="toggleCamera('stock-in')" style="margin-bottom:10px;">
      📷 Kamera Başlat
    </button>

    <div class="divider"></div>

    <p class="section-title">Manuel Barkod Giriş</p>
    <div class="form-group">
      <input class="form-input" id="manualBarcodeIn" placeholder="Barkod veya ürün adı..." type="text">
    </div>
    <div class="form-group">
      <input class="form-input" id="manualNameIn" placeholder="Ürün adı (barkod değilse boş bırakın)" type="text">
    </div>
    <button class="btn btn-blue" onclick="manualStockIn()">➕ Stoğa Ekle</button>
  </div>

  <!-- ── PACKAGE OUT MODE ── -->
  <div id="mode-package-out" style="display:none;">
    <p class="section-title">Paket Barkodu Tara → Sevk Et</p>

    <div class="camera-wrap" id="cameraWrap-package-out">
      <div class="camera-placeholder" id="placeholder-package-out">
        <div class="icon">📷</div>
        <div>Paket etiketindeki barkodu tarayın</div>
      </div>
      <video id="video-package-out" autoplay playsinline style="display:none;"></video>
      <div class="scan-line" id="scanLine-package-out" style="display:none;"></div>
      <div class="scan-corner tl" id="sc-tl-po" style="display:none;"></div>
      <div class="scan-corner tr" id="sc-tr-po" style="display:none;"></div>
      <div class="scan-corner bl" id="sc-bl-po" style="display:none;"></div>
      <div class="scan-corner br" id="sc-br-po" style="display:none;"></div>
    </div>

    <button class="btn btn-orange" id="startBtn-package-out" onclick="toggleCamera('package-out')" style="margin-bottom:10px;">
      📷 Kamera Başlat
    </button>

    <div class="divider"></div>

    <p class="section-title">Manuel Paket No</p>
    <div class="form-group">
      <input class="form-input" id="manualPackageNo" placeholder="Paket numarası (ör: pkg-12345)" type="text">
    </div>
    <button class="btn btn-red" onclick="manualPackageOut()">📤 Paketi Sevk Et</button>
  </div>

  <!-- ── MANUAL MODE ── -->
  <div id="mode-manual" style="display:none;">
    <p class="section-title">Stok Durumu Sorgula</p>
    <div class="form-group">
      <input class="form-input" id="queryName" placeholder="Ürün adı..." type="text">
    </div>
    <button class="btn btn-blue" onclick="queryStock()" style="margin-bottom:16px;">🔍 Sorgula</button>

    <div id="queryResult" style="display:none;" class="result-card show">
      <div class="result-title">Stok Bilgisi</div>
      <div class="result-value" id="queryResultName">—</div>
      <div class="result-meta" id="queryResultQty"></div>
    </div>

    <div class="divider"></div>

    <p class="section-title">Bağlantı Ayarları</p>
    <button class="btn btn-gray" onclick="resetSetup()">⚙️ Bağlantıyı Sıfırla</button>
  </div>

  <!-- LOG -->
  <div class="log-wrap" id="logWrap">
    <div class="log-title">İşlem Geçmişi</div>
    <div id="logList"></div>
  </div>

</div>

<!-- ZXing barcode library -->
<script src="https://cdn.jsdelivr.net/npm/@zxing/library@0.19.2/umd/index.min.js"></script>

<script>
// ============================================================
// CONFIG
// ============================================================
const SUPABASE_URL_KEY = 'propack_scanner_url';
const SUPABASE_KEY_KEY = 'propack_scanner_key';
const LOW_STOCK        = 5;

let supabaseUrl  = '';
let supabaseKey  = '';
let currentMode  = 'stock-in';
let cameraActive = { 'stock-in': false, 'package-out': false };
let codeReaders  = {};
let lastScanned  = '';
let lastScannedTime = 0;

// ============================================================
// SETUP
// ============================================================
function saveSetup() {
    const url = document.getElementById('setupUrl').value.trim();
    const key = document.getElementById('setupKey').value.trim();
    if (!url || !key) { showToast('URL ve Key gerekli'); return; }
    localStorage.setItem(SUPABASE_URL_KEY, url);
    localStorage.setItem(SUPABASE_KEY_KEY, key);
    supabaseUrl = url;
    supabaseKey = key;
    document.getElementById('setupScreen').style.display = 'none';
    testConnection();
}

function resetSetup() {
    localStorage.removeItem(SUPABASE_URL_KEY);
    localStorage.removeItem(SUPABASE_KEY_KEY);
    location.reload();
}

function loadSetup() {
    supabaseUrl = localStorage.getItem(SUPABASE_URL_KEY) || '';
    supabaseKey = localStorage.getItem(SUPABASE_KEY_KEY) || '';
    if (supabaseUrl && supabaseKey) {
        document.getElementById('setupScreen').style.display = 'none';
        testConnection();
    } else {
        // Pre-fill URL if known
        document.getElementById('setupUrl').value = 'https://oatkbcrkfdeywygvddkm.supabase.co';
    }
}

async function testConnection() {
    try {
        const res = await sbFetch('stock_items', { select: 'id', limit: 1 });
        if (res.ok) {
            setConnected(true);
            addLog('Supabase bağlantısı başarılı', 'success');
        } else {
            setConnected(false);
            addLog('Bağlantı hatası: ' + res.status, 'error');
        }
    } catch (e) {
        setConnected(false);
        addLog('Bağlantı hatası: ' + e.message, 'error');
    }
}

function setConnected(ok) {
    document.getElementById('statusDot').className = 'status-dot' + (ok ? ' connected' : '');
    document.getElementById('connLabel').textContent = ok ? 'Bağlı' : 'Bağlantı yok';
}

// ============================================================
// SUPABASE FETCH HELPERS
// ============================================================
async function sbFetch(table, opts = {}) {
    let url = supabaseUrl + '/rest/v1/' + table + '?';
    const params = [];
    if (opts.select)  params.push('select=' + encodeURIComponent(opts.select));
    if (opts.filter)  params.push(opts.filter);
    if (opts.limit)   params.push('limit=' + opts.limit);
    if (opts.order)   params.push('order=' + opts.order);
    url += params.join('&');

    return fetch(url, {
        headers: {
            'apikey': supabaseKey,
            'Authorization': 'Bearer ' + supabaseKey,
            'Content-Type': 'application/json',
            'Prefer': opts.prefer || 'return=representation'
        },
        method: opts.method || 'GET',
        body: opts.body ? JSON.stringify(opts.body) : undefined
    });
}

async function sbQuery(table, select, filterKey, filterVal, matchType) {
    // matchType: 'eq', 'ilike'
    const filter = filterKey + '.' + (matchType || 'eq') + '.' + encodeURIComponent(filterVal);
    const res = await sbFetch(table, { select, filter });
    if (!res.ok) return null;
    const data = await res.json();
    return Array.isArray(data) ? data[0] || null : null;
}

async function sbInsert(table, body) {
    const res = await sbFetch(table, { method: 'POST', body, prefer: 'return=representation' });
    return res;
}

async function sbUpdate(table, body, filterKey, filterVal) {
    const filter = filterKey + '.eq.' + encodeURIComponent(filterVal);
    const res = await sbFetch(table, {
        method: 'PATCH',
        body,
        filter,
        prefer: 'return=representation'
    });
    return res;
}

// ============================================================
// MODE SWITCHING
// ============================================================
function switchMode(mode) {
    // Stop any active camera
    Object.keys(cameraActive).forEach(m => {
        if (cameraActive[m]) stopCamera(m);
    });

    currentMode = mode;
    ['stock-in', 'package-out', 'manual'].forEach(m => {
        document.getElementById('mode-' + m).style.display = m === mode ? 'block' : 'none';
        document.getElementById('tab-' + m).className = 'mode-tab' + (m === mode ? ' active' : '');
    });

    hideResult();
}

// ============================================================
// CAMERA / SCANNER
// ============================================================
function toggleCamera(mode) {
    if (cameraActive[mode]) {
        stopCamera(mode);
    } else {
        startCamera(mode);
    }
}

async function startCamera(mode) {
    const video = document.getElementById('video-' + mode);
    const placeholder = document.getElementById('placeholder-' + mode);
    const btn = document.getElementById('startBtn-' + mode);
    const scanLine = document.getElementById('scanLine-' + mode);

    try {
        if (!window.ZXing) {
            showToast('❌ ZXing kütüphanesi yüklenmedi');
            return;
        }

        const hints = new Map();
        const formats = [
            ZXing.BarcodeFormat.CODE_128,
            ZXing.BarcodeFormat.CODE_39,
            ZXing.BarcodeFormat.EAN_13,
            ZXing.BarcodeFormat.EAN_8,
            ZXing.BarcodeFormat.QR_CODE,
            ZXing.BarcodeFormat.DATA_MATRIX
        ];
        hints.set(ZXing.DecodeHintType.POSSIBLE_FORMATS, formats);

        const reader = new ZXing.BrowserMultiFormatReader(hints);
        codeReaders[mode] = reader;

        const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
        });

        video.srcObject = stream;
        video.style.display = 'block';
        placeholder.style.display = 'none';
        scanLine.style.display = 'block';

        // Show corners
        const suffix = mode === 'stock-in' ? 'si' : 'po';
        ['tl','tr','bl','br'].forEach(c => {
            const el = document.getElementById('sc-' + c + '-' + suffix);
            if (el) el.style.display = 'block';
        });

        btn.textContent = '⏹ Kamerayı Durdur';
        btn.className = 'btn btn-red';
        cameraActive[mode] = true;

        reader.decodeFromStream(stream, video, (result, err) => {
            if (result) {
                const code = result.getText();
                const now = Date.now();
                // Debounce — ignore same code within 3 seconds
                if (code === lastScanned && now - lastScannedTime < 3000) return;
                lastScanned = code;
                lastScannedTime = now;

                // Vibrate on scan
                if (navigator.vibrate) navigator.vibrate([100, 50, 100]);

                if (mode === 'stock-in') {
                    handleStockInScan(code);
                } else if (mode === 'package-out') {
                    handlePackageOutScan(code);
                }
            }
        });

        addLog('Kamera başlatıldı (' + mode + ')', 'info');

    } catch (err) {
        addLog('Kamera hatası: ' + err.message, 'error');
        showToast('❌ Kamera açılamadı: ' + err.message);
    }
}

function stopCamera(mode) {
    const video = document.getElementById('video-' + mode);
    const placeholder = document.getElementById('placeholder-' + mode);
    const btn = document.getElementById('startBtn-' + mode);
    const scanLine = document.getElementById('scanLine-' + mode);

    if (codeReaders[mode]) {
        try { codeReaders[mode].reset(); } catch(e) {}
        delete codeReaders[mode];
    }

    if (video.srcObject) {
        video.srcObject.getTracks().forEach(t => t.stop());
        video.srcObject = null;
    }

    video.style.display = 'none';
    placeholder.style.display = 'flex';
    scanLine.style.display = 'none';

    const suffix = mode === 'stock-in' ? 'si' : 'po';
    ['tl','tr','bl','br'].forEach(c => {
        const el = document.getElementById('sc-' + c + '-' + suffix);
        if (el) el.style.display = 'none';
    });

    const labels = { 'stock-in': '📷 Kamera Başlat', 'package-out': '📷 Kamera Başlat' };
    btn.textContent = labels[mode];
    btn.className = 'btn ' + (mode === 'stock-in' ? 'btn-green' : 'btn-orange');
    cameraActive[mode] = false;

    addLog('Kamera durduruldu', 'info');
}

// ============================================================
// STOCK IN
// ============================================================
async function handleStockInScan(barcode) {
    const qty = parseInt(document.getElementById('stockInQty').value) || 1;
    showResult('Taranan Barkod', barcode, 'İşleniyor...', '');
    await processStockIn(barcode, barcode, qty);
}

async function manualStockIn() {
    const barcode = document.getElementById('manualBarcodeIn').value.trim();
    const name    = document.getElementById('manualNameIn').value.trim();
    const qty     = parseInt(document.getElementById('stockInQty').value) || 1;

    if (!barcode && !name) {
        showToast('Barkod veya ürün adı girin');
        return;
    }

    const itemBarcode = barcode || ('manual-' + Date.now());
    const itemName    = name || barcode;

    await processStockIn(itemBarcode, itemName, qty);

    document.getElementById('manualBarcodeIn').value = '';
    document.getElementById('manualNameIn').value = '';
}

async function processStockIn(barcode, name, qty) {
    try {
        // Check if exists
        const existing = await sbQuery('stock_items', 'id,quantity,name', 'barcode', barcode, 'eq');

        if (existing) {
            const newQty = existing.quantity + qty;
            const res = await sbUpdate('stock_items', {
                quantity: newQty,
                updated_at: new Date().toISOString()
            }, 'id', existing.id);

            if (!res.ok) throw new Error('Güncelleme hatası: ' + res.status);

            const badge = newQty <= 0 ? 'empty' : newQty <= LOW_STOCK ? 'low' : 'ok';
            showResult('✅ Stok Güncellendi', existing.name,
                'Önceki: ' + existing.quantity + ' → Yeni: ' + newQty,
                badge === 'ok' ? 'success' : 'warning');
            addLog('Güncellendi: ' + existing.name + ' → ' + newQty + ' adet', 'success');

        } else {
            // New item — if barcode != name, we need a name
            let itemName = name;
            if (barcode === name) {
                // Barcode scanned but no name — ask user
                itemName = window.prompt('Yeni ürün. Ürün adı girin:', barcode);
                if (!itemName) { addLog('İptal: isim girilmedi', 'warning'); return; }
            }

            const res = await sbInsert('stock_items', {
                barcode: barcode,
                name: itemName,
                quantity: qty,
                updated_at: new Date().toISOString(),
                created_at: new Date().toISOString()
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || res.status);
            }

            showResult('✅ Yeni Ürün Eklendi', itemName, qty + ' adet ile oluşturuldu', 'success');
            addLog('Yeni ürün: ' + itemName + ' (' + qty + ' adet)', 'success');
        }

        setConnected(true);

    } catch (err) {
        showResult('❌ Hata', err.message, '', 'error');
        addLog('Hata: ' + err.message, 'error');
        setConnected(false);
    }
}

// ============================================================
// PACKAGE OUT
// ============================================================
async function handlePackageOutScan(packageNo) {
    showResult('Taranan Paket', packageNo, 'İşleniyor...', '');
    await processPackageOut(packageNo);
}

async function manualPackageOut() {
    const packageNo = document.getElementById('manualPackageNo').value.trim();
    if (!packageNo) { showToast('Paket numarası girin'); return; }
    await processPackageOut(packageNo);
    document.getElementById('manualPackageNo').value = '';
}

async function processPackageOut(packageNo) {
    try {
        // Find the package
        const pkg = await sbQuery('packages', 'id,package_no,status,items,items_display,items_array,customer_name,total_quantity',
            'package_no', packageNo, 'eq');

        if (!pkg) {
            showResult('❌ Paket Bulunamadı', packageNo, 'Bu paket numarası sistemde yok', 'error');
            addLog('Paket bulunamadı: ' + packageNo, 'error');
            return;
        }

        if (pkg.status === 'sevk-edildi') {
            showResult('⚠️ Zaten Sevk Edildi', packageNo, 'Müşteri: ' + (pkg.customer_name || '—'), 'warning');
            addLog('Zaten sevk edildi: ' + packageNo, 'warning');
            return;
        }

        // Mark as shipped
        const containerNo = 'MOBILE-' + Date.now().toString().slice(-6);
        const res = await sbUpdate('packages', {
            status: 'sevk-edildi',
            container_id: containerNo,
            shipped_at: new Date().toISOString(),
            updated_at: new Date().toISOString()
        }, 'id', pkg.id);

        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.message || 'Güncelleme başarısız');
        }

        // Decrease stock
        await decreaseStockForPackage(pkg);

        const totalQty = pkg.total_quantity || '?';
        showResult('✅ Paket Sevk Edildi', packageNo,
            'Müşteri: ' + (pkg.customer_name || '—') + ' | Toplam: ' + totalQty + ' adet',
            'success');
        addLog('Sevk edildi: ' + packageNo + ' (' + (pkg.customer_name || '') + ')', 'success');
        setConnected(true);

    } catch (err) {
        showResult('❌ Hata', err.message, '', 'error');
        addLog('Hata: ' + err.message, 'error');
        setConnected(false);
    }
}

async function decreaseStockForPackage(pkg) {
    let items = [];

    if (pkg.items && typeof pkg.items === 'object') {
        if (Array.isArray(pkg.items)) {
            items = pkg.items;
        } else {
            items = Object.entries(pkg.items).map(([name, qty]) => ({ name, qty }));
        }
    } else if (pkg.items_array && Array.isArray(pkg.items_array)) {
        items = pkg.items_array;
    } else if (pkg.items_display) {
        items = pkg.items_display.split(',').map(s => {
            s = s.trim();
            const m = s.match(/^(.+?)\s+(\d+)$/);
            return m ? { name: m[1].trim(), qty: parseInt(m[2]) } : { name: s, qty: 1 };
        });
    }

    for (const item of items) {
        try {
            const stockItem = await sbQuery('stock_items', 'id,quantity,name', 'name', item.name, 'ilike');
            if (!stockItem) continue;

            const newQty = Math.max(0, stockItem.quantity - (item.qty || 1));
            await sbUpdate('stock_items', {
                quantity: newQty,
                updated_at: new Date().toISOString()
            }, 'id', stockItem.id);

            addLog('Stok azaldı: ' + stockItem.name + ' → ' + newQty, 'info');
        } catch (e) {
            addLog('Stok azaltma hatası (' + item.name + '): ' + e.message, 'warning');
        }
    }
}

// ============================================================
// STOCK QUERY
// ============================================================
async function queryStock() {
    const name = document.getElementById('queryName').value.trim();
    if (!name) { showToast('Ürün adı girin'); return; }

    try {
        const item = await sbQuery('stock_items', 'name,quantity,barcode,updated_at', 'name', name, 'ilike');

        const resultEl = document.getElementById('queryResult');
        const nameEl   = document.getElementById('queryResultName');
        const qtyEl    = document.getElementById('queryResultQty');

        if (!item) {
            nameEl.textContent = 'Bulunamadı';
            qtyEl.textContent  = '"' + name + '" stok sisteminde kayıtlı değil';
            resultEl.className = 'result-card show error';
        } else {
            const badge = item.quantity <= 0 ? 'empty' : item.quantity <= LOW_STOCK ? 'low' : 'ok';
            const labels = { ok: 'Yeterli', low: 'Düşük', empty: 'Tükendi' };
            nameEl.textContent = item.name;
            qtyEl.innerHTML = '<span class="stock-badge ' + badge + '">' + labels[badge] + '</span> ' +
                item.quantity + ' adet' +
                (item.barcode ? ' · Barkod: ' + item.barcode : '');
            resultEl.className = 'result-card show ' + (badge === 'ok' ? 'success' : badge === 'low' ? 'warning' : 'error');
        }

        resultEl.style.display = 'block';
        setConnected(true);
    } catch (err) {
        addLog('Sorgu hatası: ' + err.message, 'error');
        setConnected(false);
    }
}

// ============================================================
// UI HELPERS
// ============================================================
function showResult(title, value, meta, type) {
    const card = document.getElementById('resultCard');
    card.className = 'result-card show' + (type ? ' ' + type : '');
    document.getElementById('resultTitle').textContent = title;
    document.getElementById('resultValue').textContent = value;
    document.getElementById('resultMeta').textContent = meta;
    card.style.display = 'block';
}

function hideResult() {
    document.getElementById('resultCard').style.display = 'none';
}

function addLog(msg, type) {
    const list = document.getElementById('logList');
    const now  = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const item = document.createElement('div');
    item.className = 'log-item';
    item.innerHTML = '<span class="log-time">' + now + '</span>' +
                     '<span class="log-msg ' + (type || 'info') + '">' + msg + '</span>';
    list.insertBefore(item, list.firstChild);

    // Keep max 50 logs
    while (list.children.length > 50) list.removeChild(list.lastChild);
}

function showToast(msg) {
    const old = document.getElementById('toastEl');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'toastEl';
    t.className = 'toast';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { if (t.parentNode) t.remove(); }, 2800);
}

// ============================================================
// INIT
// ============================================================
loadSetup();
addLog('Pro Pack Scanner başlatıldı', 'info');
</script>
</body>
</html>
